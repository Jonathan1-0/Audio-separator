# Copia este archivo como .env y pon tus datos reales.
DATABASE_URL=mysql+pymysql://usuario:contrasena@servidor.ejemplo.com:3306/nombre_base
DB_SSL_CA=/ruta/a/ca.pem

# Opcional: cuenta de administrador para probar sin registrarse (plan oculto, sin límites).
# Pon aquí tus propios datos; NUNCA los subas al repositorio.
SPLITTER_ADMIN_EMAIL=admin@ejemplo.com
SPLITTER_ADMIN_PASSWORD=cambia-esta-contrasena

# --- Recuperar contraseña: correo de salida (Gmail con "contraseña de aplicación") ---
# Sin SPLITTER_SMTP_USER no se envía correo: el enlace aparece en la terminal del servidor.
SPLITTER_SMTP_USER=
SPLITTER_SMTP_PASSWORD=
# Clave para firmar los enlaces (cualquier texto largo y secreto).
SPLITTER_SECRET_KEY=

# --- Entrar con Google y Facebook ---
# El botón de cada uno solo aparece si tiene sus dos claves.
SPLITTER_GOOGLE_CLIENT_ID=
SPLITTER_GOOGLE_CLIENT_SECRET=
SPLITTER_FACEBOOK_APP_ID=
SPLITTER_FACEBOOK_APP_SECRET=
# Solo al publicar la página: su dirección real, por ejemplo https://splitter.ejemplo.com
SPLITTER_PUBLIC_URL=
