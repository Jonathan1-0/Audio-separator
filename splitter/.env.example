# Ejemplo de configuración.
# Copia este archivo como .env y pon tus datos reales.
# PostgreSQL (Aiven gratis):
DATABASE_URL=postgresql+psycopg://usuario:contrasena@servidor.ejemplo.com:5432/nombre_base
# o MySQL: mysql+pymysql://usuario:contrasena@servidor.ejemplo.com:3306/nombre_base
DB_SSL_CA=/ruta/a/ca.pem

# Opcional: cuenta de administrador para probar sin registrarse (plan oculto, sin límites).
# Pon aquí tus propios datos; NUNCA los subas al repositorio.
SPLITTER_ADMIN_EMAIL=admin@example.com
SPLITTER_ADMIN_PASSWORD=cambia-esta-contrasena
# Segunda cuenta de administrador (opcional)
# SPLITTER_ADMIN2_EMAIL=
# SPLITTER_ADMIN2_PASSWORD=
# SPLITTER_ADMIN2_NOMBRE=

# --- Recuperar contraseña: correo de salida (Gmail con "contraseña de aplicación") ---
# Sin SPLITTER_SMTP_USER no se envía correo: el enlace aparece en la terminal del servidor.
SPLITTER_SMTP_USER=
SPLITTER_SMTP_PASSWORD=
# Con dominio propio (Resend, Brevo…): servidor, puerto y remitente
# SPLITTER_SMTP_HOST=smtp.resend.com
# SPLITTER_SMTP_PORT=587
# SPLITTER_SMTP_FROM=no-responder@tudominio.mx
SPLITTER_SMTP_NOMBRE=Splitter
# Clave para firmar los enlaces (cualquier texto largo y secreto).
SPLITTER_SECRET_KEY=

# --- Entrar con Google y Facebook ---
# El botón de cada uno solo aparece si tiene sus dos claves.
SPLITTER_GOOGLE_CLIENT_ID=
SPLITTER_GOOGLE_CLIENT_SECRET=
SPLITTER_FACEBOOK_APP_ID=
SPLITTER_FACEBOOK_APP_SECRET=
# Solo al publicar la página: su dirección real, por ejemplo https://splitter.ejemplo.com
SPLITTER_PUBLIC_URL=

# --- Seguridad y producción ---
# SPLITTER_SECRET_KEY es obligatoria en producción: firma también las descargas y la confirmación de correo.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Correo de contacto que aparece al pie de los correos
SPLITTER_CONTACTO_EMAIL=
# 1 si hay un proxy (Nginx, Cloudflare) delante del servidor
SPLITTER_BEHIND_PROXY=0
# Otras páginas que pueden llamar a la API (CORS). Vacío = solo la misma página
SPLITTER_ALLOWED_ORIGINS=
# Logs en JSON y errores a Sentry (opcionales)
SPLITTER_LOGS_JSON=0
SPLITTER_SENTRY_DSN=
# modal (GPU) o fake (tonos de prueba, sin GPU)
SPLITTER_ENGINE=modal
# Apps de Modal: la normal (L4) y la rápida para Pro y admin (L40S). Vacía la de Pro = todos en la normal
SPLITTER_MODAL_APP=splitter-gpu-l4
SPLITTER_MODAL_APP_PRO=splitter-gpu-l40s
